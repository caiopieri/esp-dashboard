{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://desk-assistant.local/schema/card-manifest-v1.json",
  "title": "Desk Assistant card manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "kind", "type", "data", "body"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
    "title": {"type": "string", "maxLength": 64},
    "kind": {"const": "declarative"},
    "type": {"enum": ["text", "metric", "progress", "status", "clock", "list", "chart"]},
    "enabled": {"type": "boolean"},
    "deleted": {"type": "boolean"},
    "order": {"type": "integer", "minimum": 0, "maximum": 15},
    "data": {
      "type": "object",
      "required": ["source", "namespace", "key"],
      "properties": {
        "source": {"enum": ["static", "runtime", "variable"]},
        "namespace": {"type": "string", "maxLength": 32},
        "key": {"type": "string", "maxLength": 32},
        "value": {"type": "string", "maxLength": 256}
      },
      "additionalProperties": false
    },
    "body": {
      "type": "object",
      "properties": {
        "label": {"type": "string", "maxLength": 64},
        "unit": {"type": "string", "maxLength": 16},
        "max": {"type": "integer", "minimum": 1, "maximum": 100000},
        "items": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 64}}
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "object",
      "properties": {"accent": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}},
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$"},
        "label": {"type": "string", "maxLength": 32},
        "confirmationRequired": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
